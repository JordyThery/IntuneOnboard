<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>be.jordythery.intuneonboard.daemon</string>
	<!-- Absolute path into the app bundle; AssociatedBundleIdentifiers gives the
	     app attribution in System Settings > Login Items. -->
	<key>Program</key>
	<string>/Applications/Utilities/Intune Onboard.app/Contents/MacOS/onboardd</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>be.jordythery.intuneonboard</string>
	</array>
	<key>MachServices</key>
	<dict>
		<key>be.jordythery.intuneonboard.xpc</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/var/log/IntuneOnboard/onboardd.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/IntuneOnboard/onboardd.stderr.log</string>
</dict>
</plist>
